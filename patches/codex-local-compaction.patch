+/// Opening tag of the note the Taurus runtime steers in as a user message right
+/// after a compaction. It describes the boundary it was written at, so keeping
+/// it in a rebuilt history moves it to a point it does not describe. The literal
+/// is a contract with that runtime, which writes the envelope in
+/// `wrapPostCompactionMaterial` (src/agents/post-compaction-material.ts in the
+/// taurus-agents repository); neither side may change it alone.
+const POST_COMPACTION_NOTE_OPENING: &str = "<post-compaction-note";
+
+fn is_post_compaction_note(message: &str) -> bool {
+    message.trim_start().starts_with(POST_COMPACTION_NOTE_OPENING)
+}
+
+/// How the summary preamble opened before it was reworded to address the model
+/// as the author of its own earlier summary. Threads from a build that shipped
+/// the old wording still carry summaries beginning this way; matching it keeps
+/// them recognisable, so they are dropped at the next compaction instead of
+/// being retained verbatim into every later history. This build never writes it,
+/// and it can go once no such thread is live.
+const LEGACY_SUMMARY_PREFIX_OPENING: &str =
+    "Another language model started to solve this problem and produced a summary of its thinking process.";
+
 pub(crate) fn is_summary_message(message: &str) -> bool {
     message.starts_with(format!("{SUMMARY_PREFIX}\n").as_str())
+        || message.starts_with(LEGACY_SUMMARY_PREFIX_OPENING)
 }
 
