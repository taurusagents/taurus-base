# Taurus-managed subscription sidecar image
# Build: docker build -f Dockerfile.subscription -t taurus-base-subscription .
# Usage: hidden Taurus subscription sidecars use this image instead of the
# user-visible default agent container image.

ARG CODEX_GIT_REF=rust-v0.153.4
ARG CODEX_GIT_COMMIT=3d2ee51ca2d5db578f328aa75e20aa22c0197c9a
ARG CODEX_RUST_VERSION=1.95.0
ARG CODEX_BUILD_JOBS=1

# The Rust build below needs exactly one field out of the runtime manifest: the
# SHA-256 of the patch it is about to apply. Copying the whole manifest into the
# builder would tie a cached Rust compile to every edit the manifest ever gets,
# so bumping an unrelated field — a Claude Code version, say — would throw away
# an hours-long build for nothing. This stage reduces the manifest to that one
# field, and the builder depends on the reduction, which changes only when the
# digest does.
#
# jq is what fails closed here: a manifest that cannot be read or cannot be
# parsed exits non-zero and stops the build before the builder starts. A
# manifest missing the key parses fine and yields the string "null", which is
# not a digest and is rejected on the other side.
FROM ubuntu:22.04 AS codex-patch-digest
RUN apt-get update && apt-get install -y --no-install-recommends jq \
    && rm -rf /var/lib/apt/lists/*
COPY subscription-runtime-versions.json /tmp/subscription-runtime-versions.json
RUN jq -r '.codexPatchSha256' /tmp/subscription-runtime-versions.json > /codex-patch-sha256

FROM ubuntu:22.04 AS codex-builder

ARG CODEX_GIT_REF
ARG CODEX_GIT_COMMIT
ARG CODEX_RUST_VERSION
ARG CODEX_BUILD_JOBS

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH=/root/.cargo/bin:${PATH}

# The rustup installer below is pinned to the amd64 build and checked against
# the SHA-256 recorded with it, which is the only architecture this image is
# built for. Stop here rather than reach that comparison with the wrong file.
RUN [ "$(dpkg --print-architecture)" = amd64 ] \
    || { echo "taurus-base-subscription is built for amd64 only; the pinned checksums do not cover $(dpkg --print-architecture)." >&2; exit 1; }

# Keep Codex build dependencies in a throwaway stage so the runtime image stays
# small while still compiling the pinned upstream source reproducibly.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    clang \
    cmake \
    curl \
    git \
    libcap-dev \
    libclang-dev \
    libssl-dev \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

COPY patches/codex-local-compaction.patch /tmp/codex-local-compaction.patch
COPY --from=codex-patch-digest /codex-patch-sha256 /tmp/codex-patch-sha256
# The manifest's codexVariant names a revision of the patch below, and the rule
# that the revision moves whenever the patch does was prose only: the patch
# could be edited with the string left alone and nothing would notice. The
# manifest also records the patch's SHA-256, and this refuses to compile a patch
# whose bytes hash to anything else. That is narrower than it sounds and worth
# stating exactly: it binds the patch to the digest recorded beside it, so an
# edited patch can no longer ship under a manifest nobody remembered to update.
# It does not bind either of them to codexVariant — editing the patch and the
# digest together while leaving the revision number stale builds cleanly, and
# keeping that string honest stays a matter of discipline.
#
# It runs before the toolchain install and the compile because a mismatch here
# says the inputs are wrong, and finding that out after an hours-long Rust build
# helps nobody. Only the digest is copied in, not the manifest it came from, so
# a manifest edit that leaves the patch alone no longer invalidates a cached
# Rust build on a machine that had one.
#
# Learning nothing is refused rather than treated as agreement. The extracting
# stage has already failed the build on a manifest it could not read or parse;
# what reaches here is either a digest or the string "null" that jq prints for
# an absent key, so the value is required to look like a SHA-256 — 64 lowercase
# hex characters — before it is used. Without that, an absent or malformed key
# would be handed to sha256sum as a pattern, which is the failure this check
# exists to prevent, wearing the check's own clothes.
RUN set -e; \
    expected="$(cat /tmp/codex-patch-sha256)"; \
    hex=1; \
    case "$expected" in *[!0-9a-f]*) hex=0 ;; esac; \
    if [ "$hex" -ne 1 ] || [ ${#expected} -ne 64 ]; then \
      echo "The runtime manifest's codexPatchSha256 is not a SHA-256 digest (64 lowercase hex characters): '$expected'" >&2; \
      exit 1; \
    fi; \
    echo "$expected  /tmp/codex-local-compaction.patch" | sha256sum -c -
# Dependencies are downloaded and compiled in two separate steps so that no
# third-party code ever runs while the network is reachable. `cargo fetch` only
# downloads. Every crate build script — arbitrary code, run at compile time —
# then executes under `--offline`, which also stops the compile from pulling in
# any crate that was not downloaded first, so the dependency set is fixed
# before any of it is allowed to run. `--locked` on the build fails loudly if
# the patch applied below ever changes the dependency graph.
#
# The fetch deliberately does not pass `--locked`. Upstream's release tags bump
# the workspace version in Cargo.toml without regenerating Cargo.lock, so the
# committed lock is stale for upstream's own crates at every pinned tag and
# `--locked` rejects it before downloading anything. Cargo rewrites just those
# entries on first use; third-party versions and their checksums stay exactly
# as upstream committed them.
#
# `CODEX_BUILD_JOBS` defaults to 1 for memory-constrained builders but can be
# overridden by CI/staging.
#
# https://sh.rustup.rs is a script that fetches whatever rustup is current and
# runs it, so this takes the versioned installer directly and checks it against
# the SHA-256 the Rust project publishes next to it. That covers the installer
# only: rustup then downloads the pinned toolchain itself, checking each piece
# against hashes in a manifest it fetches from the same server, so the toolchain
# is whatever static.rust-lang.org serves rather than bytes reviewed here.
RUN curl -fsSL -o /tmp/rustup-init https://static.rust-lang.org/rustup/archive/1.29.1/x86_64-unknown-linux-gnu/rustup-init \
    && echo "dda7234360b7f578ca8b0ddcb80145646fa61a67c1720a5abc7051b35c9fcb71  /tmp/rustup-init" | sha256sum -c - \
    && chmod +x /tmp/rustup-init \
    && /tmp/rustup-init -y --profile minimal --default-toolchain ${CODEX_RUST_VERSION} \
    && rm -f /tmp/rustup-init \
    && git clone --depth 1 --branch ${CODEX_GIT_REF} https://github.com/openai/codex.git /tmp/codex-src \
    && cd /tmp/codex-src \
    && test "$(git rev-parse HEAD)" = "${CODEX_GIT_COMMIT}" \
    && (cd codex-rs && cargo fetch) \
    && git apply /tmp/codex-local-compaction.patch \
    && cd codex-rs \
    && cargo build --release --locked --offline -j ${CODEX_BUILD_JOBS} -p codex-cli --bin codex \
    && install -D target/release/codex /out/codex

FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# Keep the image minimal but compatible with the baked Claude/Codex CLIs.
# Taurus's Codex deferred/native-blocked resume path shells out to sqlite3 when
# it looks up rollout paths from the sidecar's state_*.sqlite databases.
RUN apt-get update && apt-get install -y --no-install-recommends \
    bash \
    ca-certificates \
    curl \
    fd-find \
    file \
    git \
    gnupg \
    jq \
    python3 \
    python3-venv \
    ripgrep \
    sqlite3 \
    && ln -s $(which fdfind) /usr/local/bin/fd \
    && rm -rf /var/lib/apt/lists/*

# Match Taurus base's pinned Node.js stream so the subscription sidecar moves on
# the same deliberate review cadence as the main Taurus image family.
RUN mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/gpgkey/nodesource-repo.gpg.key \
    | gpg --dearmor -o /etc/apt/keyrings/nodesource.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/nodesource.gpg] https://deb.nodesource.com/node_24.x nodistro main" \
    > /etc/apt/sources.list.d/nodesource.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends nodejs=24.15.0-1nodesource1 \
    && rm -rf /var/lib/apt/lists/*

ARG CODEX_GIT_COMMIT
COPY subscription-runtime-versions.json /tmp/subscription-runtime-versions.json
COPY subscription-cli-version-check.mjs /tmp/subscription-cli-version-check.mjs
COPY npm/subscription/package.json npm/subscription/package-lock.json /opt/taurus-npm/subscription/
# `npm ci` installs exactly the tree recorded in the lockfile, so every version
# and tarball hash in it — not just the two named in package.json — is fixed at
# the moment the lockfile was committed and reviewed.
#
# The two CLI versions are written down twice: in package.json, which decides
# what is installed, and in subscription-runtime-versions.json, the manifest
# baked into this image. The workflow smoke reads it back, and so does Taurus:
# when it brings a sidecar up it compares the manifest against the CLI versions
# the application itself was built for, so a node still on an older image
# announces itself instead of quietly serving the wrong runtime. They are
# separate files a human edits by hand, so the build compares them first and
# stops if they have drifted rather than shipping an image whose manifest
# describes something other than what is in it.
#
# The manifest's Codex fields are checked the same way and for the same reason.
# Nothing else in the build reads codexSourceRef, so without this a manifest
# naming a commit other than the one actually compiled would ship unnoticed —
# and a manifest that lies about where the binary came from defeats the point of
# recording it. The variant string is required to describe the version it claims
# to be a build of, which catches half-finished version bumps.
#
# `--ignore-scripts` blocks install hooks, which is how a hostile npm package
# normally gets to run code. Exactly one hook here is load-bearing: the Claude
# Code wrapper ships a stub and its postinstall copies the real platform binary
# over it, so that single reviewed script is run explicitly below. It exits 0
# even when it finds no binary to place, hence the version check that follows —
# which compares what the binary reports against the manifest rather than merely
# proving that something answers, since a stub that runs is exactly the failure
# being guarded against.
#
# The symlinks put the packages back where the rest of Taurus looks for them:
# NODE_PATH points at /usr/lib/node_modules, the sidecar wrapper resolves the
# MCP SDK from that directory, and /usr/bin/claude is called by absolute path.
# Node resolves a symlink to its real location before looking for a package's
# own dependencies, so both packages still find theirs inside this tree.
RUN node -e "const manifest = require('/tmp/subscription-runtime-versions.json'); const pinned = require('/opt/taurus-npm/subscription/package.json').dependencies; for (const [key, name] of [['claudeCode', '@anthropic-ai/claude-code'], ['mcpSdk', '@modelcontextprotocol/sdk']]) { if (manifest[key] !== pinned[name]) { console.error('Version drift: the runtime manifest says ' + key + '=' + manifest[key] + ', but ' + name + ' is pinned at ' + pinned[name]); process.exit(1); } } const builtRef = 'openai/codex@' + process.env.CODEX_GIT_COMMIT; if (manifest.codexSourceRef !== builtRef) { console.error('Version drift: the runtime manifest says codexSourceRef=' + manifest.codexSourceRef + ', but this image compiles ' + builtRef); process.exit(1); } if (!manifest.codexVariant.startsWith(manifest.codex + '+')) { console.error('Version drift: codexVariant ' + manifest.codexVariant + ' does not describe a build of codex ' + manifest.codex); process.exit(1); }" \
    && npm ci --prefix /opt/taurus-npm/subscription --ignore-scripts \
    && mkdir -p /usr/lib/node_modules/@anthropic-ai /usr/lib/node_modules/@modelcontextprotocol \
    && ln -s /opt/taurus-npm/subscription/node_modules/@anthropic-ai/claude-code /usr/lib/node_modules/@anthropic-ai/claude-code \
    && ln -s /opt/taurus-npm/subscription/node_modules/@modelcontextprotocol/sdk /usr/lib/node_modules/@modelcontextprotocol/sdk \
    && ln -s /opt/taurus-npm/subscription/node_modules/@anthropic-ai/claude-code/bin/claude.exe /usr/bin/claude \
    && node /opt/taurus-npm/subscription/node_modules/@anthropic-ai/claude-code/install.cjs \
    && timeout -k 10 60 claude --version > /tmp/claude-version 2>&1 \
    && cat /tmp/claude-version \
    && node /tmp/subscription-cli-version-check.mjs /tmp/subscription-runtime-versions.json claudeCode /tmp/claude-version \
    && rm -f /tmp/claude-version \
    && mkdir -p /usr/local/lib/taurus-subscription \
    && cp /tmp/subscription-runtime-versions.json /usr/local/lib/taurus-subscription/runtime-versions.json \
    && rm -f /tmp/subscription-runtime-versions.json

COPY patches/codex-local-compaction.patch /tmp/codex-local-compaction.patch
COPY codex-app-server-smoke.mjs /tmp/codex-app-server-smoke.mjs
COPY --from=codex-builder /out/codex /usr/bin/codex
# Fail the image build immediately if the patched Codex binary cannot start the
# same stdio app-server Taurus uses in subscription sidecars.
#
# Both baked CLIs are checked the same way, by the same script: the version the
# binary must report is read out of the manifest rather than written here as a
# second copy of the same string, so a bump has one place to change and neither
# check can silently pass against a stale literal. The comparison lives in a
# script instead of a shell one-liner because it has to fail closed on a
# manifest it cannot read or a key that is not there, and a substitution that
# produces nothing reads to `grep` as a pattern that matches every line.
#
# `timeout -k 10 60` is the answer to the other way a version check goes quiet:
# a binary that hangs instead of failing would otherwise hold the build until
# the job's own cap kills it, hours later and without naming the cause. The
# `-k` matters — plain `timeout` sends SIGTERM and then waits indefinitely for a
# process that ignores it, which is the same hang with extra steps. Both CLI
# checks are spelled this way for that reason.
#
# Both also fold stderr into the captured file. A CLI that prints its banner to
# stderr would otherwise leave an empty file for the comparison while the real
# text scrolled past in the build log, where nothing reads it: an empty capture
# fails the check, but for the wrong reason and with a misleading message. The
# cost is that any stderr noise is compared too, which can only mask a mismatch
# if the noise happens to contain the exact version the manifest expects.
RUN chmod 0755 /usr/bin/codex \
    && ln -sf /usr/bin/codex /usr/local/bin/codex \
    && timeout -k 10 60 /usr/bin/codex --version > /tmp/codex-version 2>&1 \
    && cat /tmp/codex-version \
    && node /tmp/subscription-cli-version-check.mjs /usr/local/lib/taurus-subscription/runtime-versions.json codex /tmp/codex-version \
    && CODEX_HOME=/root/.codex-smoke-home node /tmp/codex-app-server-smoke.mjs /usr/bin/codex \
    && cp /tmp/codex-local-compaction.patch /usr/local/lib/taurus-subscription/codex-local-compaction.patch \
    && rm -f /tmp/codex-app-server-smoke.mjs /tmp/codex-local-compaction.patch /tmp/codex-version /tmp/subscription-cli-version-check.mjs

ENV NODE_PATH=/usr/lib/node_modules

# Taurus intentionally keeps wrapper/helper assets app-mounted under
# /provider/taurus-mcp so wrapper changes can ship without rebuilding this image.
WORKDIR /provider
